# Public address of the site (used in canonical / Open Graph / schema tags)
SITE_URL=https://www.fixwebsiteissues.com

# Form emails (optional). Without SMTP_HOST, submissions are only saved to data/form-submissions.jsonl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Send every form to this address instead of the address set in each WordPress form
FORM_EMAIL_TO=
